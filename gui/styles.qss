/* Baxters HQ Sample Pack Generator stylesheet */
QWidget#MainWindow {
  background: transparent;
  border-radius: 18px;
}

/* Backdrops applied to central widget at runtime */

QWidget#TopBar {
  background: #000000;
  color: #eaeaea;
  border-radius: 0px;
}

QWidget#BottomBar {
  background: rgba(20,20,20,0.6);
  color: #eaeaea;
  border-radius: 8px;
}

/* Top lane container - button rows at top */
QWidget#top_lane_container {
  background: transparent;
  border: 2px solid #000000;
  border-radius: 12px;
  padding: 4px;
}

/* Collapsible debug drawer */
#CollapsibleDrawer {
  background: #1a1a1a;
  color: #007BFF;
  border: 2px solid #000;
  border-radius: 18px;
}

#DebugTerminal {
  background: #000000;
  color: #4FC3FF;
  border: none;
  font-family: Consolas, "Courier New", monospace;
  font-size: 11px;
}

QPushButton {
  background: #4FC3FF;  /* light blue */
  color: #000000;  /* black text */
  padding: 6px 12px;
  border: 2px solid #000000;  /* black outline */
  border-radius: 6px;
  font-weight: bold;
  font-size: 11px;
}

QPushButton:hover {
  background: #6DD5FF;  /* lighter blue on hover */
  border: 2px solid #000000;
  color: #000000;
}

QPushButton:pressed {
  background: #3AB3EF;  /* darker blue when pressed */
  border: 2px solid #000000;
  color: #000000;
}

QCheckBox, QComboBox {
  color: #eaeaea;
}

QCheckBox::indicator {
  width: 14px;
  height: 14px;
  border: 2px solid #000000;
  border-radius: 3px;
  background: #ffffff;
}

QCheckBox::indicator:checked {
  background: #ffffff;
  border: 2px solid #000000;
  image: url(hqspg/assets/check_black.svg);
}

QLabel#AppNameLabel {
  color: #4FC3FF; /* light blue */
  font-weight: 600;
  font-size: 16px;
  padding-left: 6px;
}

/* ── Status pill (default / Idle state) ────────────────────── */
QLabel#StatusPill {
  background: rgba(255,255,255,0.12);
  color: #eaeaea;
  border: 1px solid rgba(255,255,255,0.30);
  border-radius: 6px;
  padding: 2px 8px;
  font-weight: 700;
  font-size: 11px;
}

/* ── Pipeline progress bar ────────────────────────────── */
QProgressBar#PipelineProgress {
  background: rgba(0,0,0,0.35);
  border: 1px solid rgba(255,255,255,0.25);
  border-radius: 6px;
  color: #000000;
  font-weight: 700;
  font-size: 10px;
  text-align: center;
}
QProgressBar#PipelineProgress::chunk {
  background: qlineargradient(
    x1:0, y1:0, x2:1, y2:0,
    stop:0 #4FC3FF, stop:1 #2a9fd6
  );
  border-radius: 5px;
}

/* ── File IO display boxes ─────────────────────────────── */
QLabel#FileIODisplay {
  background: #d0d0d0;
  color: #111111;
  border: 1px solid #999999;
  border-radius: 4px;
  padding: 2px 6px;
  font-size: 11px;
}

/* ── Thermometer icon ─────────────────────────────────── */
QLabel#ThermometerIcon {
  background: transparent;
  color: #eaeaea;
}

/* ── HRT beacon label ───────────────────────────────── */
/* Default (unknown/startup) state — purple pill */
QLabel#HRTBeacon {
  background: #9040C8;
  color: #000000;
  border: 1px solid #000000;
  border-radius: 6px;
  font-size: 11px;
  font-weight: 600;
  padding: 2px 8px;
}

/* ── Tooltip popup ──────────────────────────────────── */
QToolTip {
  background: #9040C8;
  color: #000000;
  border: 1px solid #000000;
  border-radius: 4px;
  padding: 6px 10px;
  font-size: 11px;
}

/* ── HQ title bar ────────────────────────────────────────── */
QWidget#HQTitleBar {
  background: #000000;
  border: 1px solid rgba(255,255,255,0.35);
  border-bottom: none;
  border-top-left-radius: 18px;
  border-top-right-radius: 18px;
}
QLabel#HQTitleLabel {
  color: #4FC3FF;
  font-weight: 700;
  font-size: 14px;
  padding-left: 4px;
  letter-spacing: 1px;
}

/* Title bar buttons */
QWidget#CustomTitleBar {
  background: #000000;
  border: 1px solid rgba(255,255,255,0.35);
  border-bottom: none;
  border-top-left-radius: 18px;
  border-top-right-radius: 18px;
}
QLabel#TitleBarAppName { color: #4FC3FF; font-weight: 600; font-size: 14px; padding-left:6px }
QPushButton#TitleBarMin {
  background: rgba(255,255,255,0.15);
  color: #ffffff;
  border: 1px solid rgba(255,255,255,0.25);
  border-radius: 4px;
  font-size: 13px;
  font-weight: 700;
  font-family: "Segoe UI", "Arial", sans-serif;
  padding: 0 6px;
}
QPushButton#TitleBarMin:hover {
  background: rgba(255,255,255,0.28);
  border-color: rgba(255,255,255,0.45);
}
QPushButton#TitleBarClose {
  background: rgba(255,255,255,0.15);
  color: #ffffff;
  border: 1px solid rgba(255,255,255,0.25);
  border-radius: 4px;
  font-size: 13px;
  font-weight: 700;
  font-family: "Segoe UI", "Arial", sans-serif;
  padding: 0 6px;
}
QPushButton#TitleBarClose:hover { background: #d41515; border-color: #d41515; }

QLabel#Indicator {
  color: #00ff88;
  font-weight: bold;
}

/* When backdrop-off theme is active, application logic will set central widget properties */

/* Central widget backdrop via Qt resource */
QWidget#CentralWidget {
  background-image: url(":/assets/background.png");
  background-repeat: no-repeat;
  background-position: center;
  background-color: #111; /* fallback background */
  border: 1px solid rgba(255,255,255,0.35);
  border-top: none;
  border-bottom-left-radius: 18px;
  border-bottom-right-radius: 18px;
  padding: 0px;
  margin: 0px;
}

QWidget#BottomBand {
  padding-right: 12px; /* give space for Settings button */
}
